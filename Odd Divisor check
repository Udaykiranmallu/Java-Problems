
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            long n = sc.nextLong();

            while (n % 2 == 0) {
                n /= 2;
            }

            if (n == 1) {
                System.out.print("NO ");
            } else {
                System.out.print("YES ");
            }
        }

        sc.close();
    }
}
