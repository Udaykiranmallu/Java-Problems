package Day5;

import java.lang.reflect.Array;
import java.util.Arrays;

public class Passing {
    public void suggest(double[] list){
        for(double each :list){
            if(each>=4.5&&each<=10)
                System.out.println("Eligible 7L with 15% of ROI:");
            else if(each>10&&each<=25.1)
                System.out.println("Bussiness loan 20L with 8% of ROI:");
            else
                System.out.println("PL of 2L in 27% intrest:");
        }
    }
    public void deduct(double itr){
        itr =(itr>12&& itr<=20)?itr-=(itr*0.10):
        (itr>20&&itr<=25)?itr-=(itr*0.20):
        (itr>25)?itr-=(itr*0.30):itr;
        System.out.println("Deducted"+itr);

    }
    public void ordering(double[]salary){
        Arrays.sort(salary);
    }
    public static void main(String[] args) {
        double[] annual ={12.5,9.2,7.5,45.8,2.1};
        Passing pass = new Passing();
        pass.suggest(annual);
        pass.deduct(annual[3]);
        System.out.println(Array.toString(annual));
        pass.ordering(annual);
        System.out.println(Array.toString(annual));
    }
    
}
