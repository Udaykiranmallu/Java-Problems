import java.util.*;

class CodeChef {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();

            int prev = sc.nextInt();
            int current = 1;
            int max = 1;

            for (int i = 1; i < N; i++) {
                int x = sc.nextInt();

                if (x == prev + 1) {
                    current++;
                } else {
                    current = 1;
                }

                max = Math.max(max, current);
                prev = x;
            }

            System.out.println(N - max);
        }

        sc.close();
    }
}
