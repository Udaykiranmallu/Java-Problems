class Solution {
    public int rob(int[] arr) {
        if(arr==null||arr.length==0) return 0;
        if(arr.length==1) return arr[0];
        int prev1=Math.max(arr[0],arr[1]),prev2=arr[0];
        for(int ind=2;ind<arr.length;ind++){
            int sum=Math.max(prev1,prev2+arr[ind]);
            prev2=prev1;
            prev1=sum;

        }
        return prev1;
    }
}
