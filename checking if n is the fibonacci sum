class Solution {
    public boolean isThreeFibonacciSum(int n) {
        int a = 0, b = 1, c = 1;

        while (true) {
            if (a + b + c == n)
                return true;

            int next = b + c;
            a = b;
            b = c;
            c = next;

            if (a + b + c > n)
                return false;
        }
    }
}
