class Solution {
    public void moveZeroes(int[] nums) {
        int n = nums.length;
        int[] temp = new int[n];
        int ind=0;
        for(int i=0;i<n;i++){
            if(nums[i]!=0){
                temp[ind] = nums[i];
                ind++;
            }
        }
        int temp_size = temp.length;
        for(int i=0;i<temp_size;i++){
            nums[i] = temp[i];
        }
        for(int i=temp_size;i<n;i++){
            nums[i]=0;
            System.out.print(nums[i]);
        }
        //System.out.print(nums[i]);
    }
}
